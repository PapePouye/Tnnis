# GEMINI_API_KEY: Required for server-side Gemini API calls with Google Search Grounding
# to research live tennis predictions, match conditions, and odds from reputable sources.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ODDS_API_KEY: Optional. If provided (from the-odds-api.com), the server will also query
# live regulated bookmaker tennis odds feeds directly in addition to grounded web search.
ODDS_API_KEY=""

